# Variable NAMES of the production secrets file (.env.prod.sops, dotenv format).
# Values are never stored here. Create the real file with:
#   sops edit --input-type dotenv --output-type dotenv .env.prod.sops
# (the editor never writes the plaintext to disk; never create the file by hand)
# Firebase service account fields (src/config.py, firebase_credentials): PRIVATE_KEY holds
# the key on one line, with "/breakline/" in place of each newline.
TYPE=
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
AUTH_URI=
TOKEN_URI=
AUTH_PROVIDER_X509_CERT_URL=
CLIENT_X509_CERT_URL=
UNIVERSE_DOMAIN=
# App password (src/config.py, check_password).
PASSWORD=
